# =============================================================================
# Dockerignore - Optimized for Lightweight Render Free Tier Build (< 500 MB)
# =============================================================================

# Version control & deploy configs
.git/
.gitignore
.gitattributes
.vercelignore
vercel.json

# Local state & secrets (never bake into images)
data/
**/*.db
**/*.db-wal
**/*.db-shm
**/demo_credentials.csv
**/initial_admin_password.txt
.env
.env.*

# Python caches & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE & OS temporary files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Heavy training backups & notebooks (saves ~400 MB)
collab_content_backup/
notebooks/
.ipynb_checkpoints/
Untitled*.ipynb

# Heavy PyTorch / YOLO weights (saves ~106 MB; YOLO runs in browser via ONNX)
models/weights/
*.pt

# Heavy / redundant artifacts not loaded at runtime (saves ~50 MB)
artifacts/archive/
artifacts/pipelines/boosters/
artifacts/figures/
artifacts/*.pptx
artifacts/*.png

# Offline development, training & evaluation scripts (not used by API)
tests/
experiments/
docs/
data_pipeline/
evaluation/
explainability/
scripts/
frontend_dist/
*.md

# Docker-specific local files
docker-compose*.yml
docker-start.*
Dockerfile.gpu
