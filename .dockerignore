# Version control
.git/
.gitignore
.gitattributes

# Local state and SECRETS: accounts database, demo passwords, the admin one-time password, camera counts.
# `COPY data/` would otherwise bake all of it into the image.
data/live/
**/*.db
**/*.db-wal
**/*.db-shm
**/demo_credentials.csv
**/initial_admin_password.txt
.env
.env.*

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Environments
.venv/
venv/
ENV/
env/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Not needed at runtime
tests/
notebooks/
experiments/
docs/
.ipynb_checkpoints/
Untitled0.ipynb
frontend_dist/
artifacts/archive/
*.md

# YOLO dataset and training runs (hundreds of MB; the app never reads them). Weights live in models/weights.
collab_content_backup/
