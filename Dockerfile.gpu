# =============================================================================
# LPU Campus Parking Intelligence System - GPU Dockerfile (NVIDIA CUDA 12.1)
#
# Only needed for server-side YOLO on a GPU host (NVIDIA Container Toolkit). The default Dockerfile (lean image) is
# what Render uses. This file is NOT built or tested by CI: verify it on your GPU machine.
#
#   docker build -f Dockerfile.gpu -t campus-parking-intelligence:gpu .
#   docker run -d --gpus all -p 8000:8000 -v parking-data:/data -e AUTH_DB=/data/app.db \
#       -e PARKING_DB=/data/observations.db campus-parking-intelligence:gpu
# See the header of Dockerfile for the runtime environment variables.
# =============================================================================

FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TORCHINDUCTOR_CACHE_DIR=/tmp/torch_inductor \
    TORCH_HOME=/tmp/torch \
    YOLO_CONFIG_DIR=/tmp/Ultralytics \
    MPLCONFIGDIR=/tmp/matplotlib \
    PORT=8000 \
    FORWARDED_ALLOW_IPS=127.0.0.1

# Python 3.11 and system libraries (Ubuntu 22.04 ships 3.10; 3.11 comes from the deadsnakes PPA)
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common curl \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
       python3.11 python3.11-dev python3.11-venv python3-pip libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Set python3.11 as default python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

WORKDIR /app

RUN groupadd -r -g 1000 appgroup && \
    useradd -r -u 1000 -g appgroup -d /home/appuser -m -s /bin/bash appuser && \
    mkdir -p /tmp/torch_inductor /tmp/torch /tmp/Ultralytics /tmp/matplotlib /app/data/live /var/data && \
    chown -R appuser:appgroup /tmp/torch_inductor /tmp/torch /tmp/Ultralytics /tmp/matplotlib /app /var/data

COPY requirements.txt requirements-full.txt ./

# PyTorch with CUDA 12.1 support, then the rest
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cu121 && \
    pip install -r requirements-full.txt

# Source tree and model weights
COPY --chown=appuser:appgroup api/ ./api/
COPY --chown=appuser:appgroup artifacts/ ./artifacts/
COPY --chown=appuser:appgroup configs/ ./configs/
COPY --chown=appuser:appgroup computer_vision/ ./computer_vision/
COPY --chown=appuser:appgroup data/ ./data/
COPY --chown=appuser:appgroup data_collection/ ./data_collection/
COPY --chown=appuser:appgroup data_pipeline/ ./data_pipeline/
COPY --chown=appuser:appgroup evaluation/ ./evaluation/
COPY --chown=appuser:appgroup features/ ./features/
COPY --chown=appuser:appgroup frontend/ ./frontend/
COPY --chown=appuser:appgroup public/ ./public/
COPY --chown=appuser:appgroup models/ ./models/
COPY --chown=appuser:appgroup recommendation/ ./recommendation/
COPY --chown=appuser:appgroup scripts/ ./scripts/
COPY --chown=appuser:appgroup utils/ ./utils/

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh && chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS "http://localhost:${PORT:-8000}/api/health" || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["sh", "-c", "exec python -m uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
